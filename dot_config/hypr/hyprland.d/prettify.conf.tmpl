general {
    border_size=0
    gaps_in=2
    gaps_out=5,5,5,5
    
    # apply_sens_to_raw=0
    # sensitivity=0.50
    # main_mod=SUPER
}

decoration {

    # Inactive tile configs
    # Dimming
    dim_inactive=true
    dim_strength=0.1

    inactive_opacity=0.85
    
    # Prettify
    rounding=22
    blur {
        enabled=true
        size=2
        passes=2
        new_optimizations = true
    }

    shadow {
        enabled=true
        range=10
        render_power=4
        color=0x441a1a1a
      }
}

animations {
    enabled=1
    bezier=easeInOutQuart,0.76, 0, 0.24, 1
    bezier=easeOutQuart,0.25, 1, 0.5, 1
    animation=windows,1,7,easeOutQuart,slide
    animation=workspaces,1,7,easeOutQuart,slide
}

group {
  groupbar {
      indicator_height=0
      height=20
      gradient_rounding=10
      gradients=true
      font_size=10
      text_color=0xff{{ .iroha.onPrimary.hex_unhashed }}
      col.active=0xff{{ .iroha.primary.hex_unhashed }}
      text_color_inactive=0xff{{ .iroha.onPrimaryContainer.hex_unhashed }}
      col.inactive=0xff{{ .iroha.primaryContainer.hex_unhashed }}
      scrolling=false
      keep_upper_gap=false
      gradient_round_only_edges=false
      gaps_in=5
      gaps_out=5
    }
  }

misc {
    font_family=SpaceMono Nerd Font
    splash_font_family=SpaceMono Nerd Font
  }
